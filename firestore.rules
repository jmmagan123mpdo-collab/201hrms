rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'jmmagan123mpdo@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role helpers
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isHRAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        getUserData().role == 'hr_admin' || 
        getUserData().role == 'developer'
      );
    }

    function isDeveloper() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        getUserData().role == 'developer'
      );
    }

    function isHRStaff() {
      return isSignedIn() && (
        getUserData().role == 'hr_staff' ||
        isHRAdmin()
      );
    }

    function isPayroll() {
      return isSignedIn() && (
        getUserData().role == 'payroll' ||
        isHRAdmin()
      );
    }

    function isValidEmailLog(data) {
      return data.keys().hasAll([
          'id', 'leaveApplicationId', 'workflowType', 'workflowStage',
          'recipientEmail', 'recipientRole', 'subject', 'provider',
          'status', 'triggeredByUid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'leaveApplicationId', 'workflowType', 'workflowStage',
          'applicantName', 'recipientEmail', 'recipientRole', 'recipientName',
          'subject', 'bodyPreview', 'provider', 'providerMessageId',
          'httpStatusCode', 'status', 'errorMessage', 'triggeredByUid',
          'triggeredByName', 'createdAt'
        ])
        && isValidId(data.id)
        && data.leaveApplicationId is string && data.leaveApplicationId.size() > 0 && data.leaveApplicationId.size() <= 128
        && data.workflowType in ['CSC_FORM_6', 'WELLNESS_W01', 'WELLNESS_W02', 'SYSTEM_TEST']
        && data.workflowStage in [
          'stage_1_submitted', 'stage_2_supervisor_approved', 'stage_2_supervisor_disapproved',
          'stage_3_mayor_approved', 'stage_3_mayor_disapproved', 'stage_5_hr_finalized',
          'stage_5_hr_returned', 'test_dispatch'
        ]
        && data.recipientEmail is string && data.recipientEmail.size() >= 3 && data.recipientEmail.size() <= 160
        && data.recipientRole in ['supervisor', 'mayor', 'hr_final_reviewer', 'employee', 'test']
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 240
        && data.provider in ['sendgrid', 'mailgun', 'none']
        && data.status in ['sent', 'failed', 'unconfigured', 'skipped']
        && data.triggeredByUid is string && data.triggeredByUid.size() > 0 && data.triggeredByUid.size() <= 128 && data.triggeredByUid == request.auth.uid
        && data.createdAt == request.time
        && (!('applicantName' in data) || (data.applicantName is string && data.applicantName.size() <= 120))
        && (!('recipientName' in data) || (data.recipientName is string && data.recipientName.size() <= 120))
        && (!('bodyPreview' in data) || (data.bodyPreview is string && data.bodyPreview.size() <= 1000))
        && (!('providerMessageId' in data) || (data.providerMessageId is string && data.providerMessageId.size() <= 200))
        && (!('httpStatusCode' in data) || data.httpStatusCode is number)
        && (!('errorMessage' in data) || (data.errorMessage is string && data.errorMessage.size() <= 500))
        && (!('triggeredByName' in data) || (data.triggeredByName is string && data.triggeredByName.size() <= 120));
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll([
          'supervisorEmail', 'mayorEmail', 'hrFinalReviewerEmail', 'emailNotificationsEnabled', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'systemName', 'lguName', 'provinceName', 'currentTermYear', 'headOfAgency', 'hrmoHead',
          'essSelfRegistrationEnabled', 'maintenanceMode', 'supervisorEmail', 'mayorEmail',
          'hrFinalReviewerEmail', 'emailNotificationsEnabled', 'updatedByUid', 'updatedAt'
        ])
        && data.supervisorEmail is string && data.supervisorEmail.size() >= 3 && data.supervisorEmail.size() <= 160
        && data.mayorEmail is string && data.mayorEmail.size() >= 3 && data.mayorEmail.size() <= 160
        && data.hrFinalReviewerEmail is string && data.hrFinalReviewerEmail.size() >= 3 && data.hrFinalReviewerEmail.size() <= 160
        && data.emailNotificationsEnabled is bool
        && data.updatedAt == request.time
        && (!('systemName' in data) || (data.systemName is string && data.systemName.size() <= 150))
        && (!('lguName' in data) || (data.lguName is string && data.lguName.size() <= 150))
        && (!('provinceName' in data) || (data.provinceName is string && data.provinceName.size() <= 150))
        && (!('currentTermYear' in data) || data.currentTermYear is number)
        && (!('headOfAgency' in data) || (data.headOfAgency is string && data.headOfAgency.size() <= 150))
        && (!('hrmoHead' in data) || (data.hrmoHead is string && data.hrmoHead.size() <= 150))
        && (!('essSelfRegistrationEnabled' in data) || data.essSelfRegistrationEnabled is bool)
        && (!('maintenanceMode' in data) || data.maintenanceMode is bool)
        && (!('updatedByUid' in data) || (data.updatedByUid is string && data.updatedByUid.size() <= 128 && data.updatedByUid == request.auth.uid));
    }

    // Fallback deny-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isHRAdmin());
      allow delete: if isDeveloper();
    }

    // Employees masterlist
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create, update: if isHRStaff();
      allow delete: if isHRAdmin();
    }

    // Municipal Offices
    match /offices/{officeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isHRAdmin();
    }

    // 201 Personnel Documents
    match /employeeDocuments/{documentId} {
      allow read: if isSignedIn() && (
        isHRStaff() ||
        (resource.data.employeeId == getUserData().employeeId && resource.data.privacy == 'employee_accessible')
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isHRStaff() || resource.data.employeeId == getUserData().employeeId);
      allow delete: if isHRAdmin();
    }

    // Document Requests
    match /documentRequests/{requestId} {
      allow read: if isSignedIn() && (
        isHRStaff() || resource.data.employeeId == getUserData().employeeId
      );
      allow create, update: if isSignedIn();
      allow delete: if isHRAdmin();
    }

    // Leave Applications
    match /leaveApplications/{applicationId} {
      allow read: if isSignedIn() && (
        isHRStaff() || resource.data.employeeId == getUserData().employeeId
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isHRAdmin();
    }

    // Wellness Applications (W-01 and W-02)
    match /wellnessApplications/{applicationId} {
      allow read: if isSignedIn() && (
        isHRStaff() || resource.data.employeeId == getUserData().employeeId
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isHRAdmin();
    }

    // SALN Records
    match /salnRecords/{salnId} {
      allow read: if isSignedIn() && (
        isHRStaff() || resource.data.employeeId == getUserData().employeeId
      );
      allow create, update: if isSignedIn();
      allow delete: if isHRAdmin();
    }

    // Biometric & Daily Attendance Records
    match /biometricRecords/{recordId} {
      allow read: if isSignedIn() && (
        isHRStaff() || resource.data.employeeId == getUserData().employeeId
      );
      allow create, update: if isHRStaff();
      allow delete: if isHRAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid ||
        (resource.data.recipientRole == 'hr_staff' && isHRStaff()) ||
        (resource.data.recipientRole == 'admin' && isHRAdmin())
      );
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isHRAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit records
    }

    // Transactional Email Logs (Immutable Audit Trail)
    match /emailLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (isHRStaff() || resource.data.triggeredByUid == request.auth.uid);
      allow list: if isSignedIn() && (isBootstrappedAdmin() || resource.data.triggeredByUid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(logId) && isValidEmailLog(incoming());
      allow update, delete: if false;
    }

    // System Settings & Workflow Approver Configuration
    match /systemSettings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isBootstrappedAdmin();
      allow create, update: if isSignedIn() && isValidId(settingId) && (isDeveloper() || isHRAdmin()) && isValidSystemSettings(incoming());
      allow delete: if false;
    }
  }
}
